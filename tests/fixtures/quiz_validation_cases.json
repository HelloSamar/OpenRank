{
 "about": "Shared test cases for the quiz question validator. 'valid' says whether Telegram can post the question. These assume question numbers are shown ('Q12/100: ' reserves 12 characters, so a question may have at most 288 characters). Any other runtime (for example the Cloudflare Worker) must give the same answers.",
 "limits": {
  "question": 300,
  "question_prefix_reserve": 12,
  "option": 100,
  "explanation": 200,
  "options_min": 2,
  "options_max": 10,
  "explanation_line_breaks_max": 2
 },
 "cases": [
  {
   "name": "minimal valid question with explanation",
   "item": [
    "Capital of France?",
    [
     "Paris",
     "Rome",
     "Oslo",
     "Bern"
    ],
    0,
    "Paris is the capital."
   ],
   "valid": true
  },
  {
   "name": "valid without an explanation (3 items)",
   "item": [
    "Capital of France?",
    [
     "Paris",
     "Rome"
    ],
    1
   ],
   "valid": true
  },
  {
   "name": "valid with an empty explanation",
   "item": [
    "Q?",
    [
     "a",
     "b"
    ],
    0,
    ""
   ],
   "valid": true
  },
  {
   "name": "two options is the minimum",
